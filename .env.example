# ─────────────────────────────────────────────────────────────────────────────
# Agbota Segun — environment configuration
# Copy this file to `.env` and fill in your values.  Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port for the application server
PORT=3000

# Node environment: development | production
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# If DATABASE_URL is set, the server connects to that PostgreSQL instance
# (works with Supabase, Neon, RDS or any hosted PostgreSQL).
#   Example (Supabase pooler):
#   DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# If DATABASE_URL is left empty, the server runs on an embedded PostgreSQL
# engine (PGlite) stored in ./data/db — zero setup for local development.
DATABASE_URL=

# ── Authentication ──────────────────────────────────────────────────────────
# Long random secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Owner / Admin account ───────────────────────────────────────────────────
# Created automatically on first boot if no owner account exists.
# These are the INITIAL credentials — log in once and change the password
# from Admin → Settings. The password is hashed with bcrypt before storage
# and is never exposed to the browser.
ADMIN_EMAIL=agbotasegun.outreach@gmail.com
ADMIN_PASSWORD=ecomexpert

# ── Payments (shown to streamers when they report a payment) ────────────────
# Bitcoin wallet address for BTC payments.
BTC_ADDRESS=
# PayPal instructions are delivered personally through Chat after ordering.
PAYPAL_INSTRUCTIONS=PayPal payments are arranged personally through Chat after you place your order.

# ── Uploads ─────────────────────────────────────────────────────────────────
# Maximum size of a single uploaded attachment in megabytes.
MAX_UPLOAD_MB=20
